# UNTESTED. Build from a checkout: makepkg -si (run inside a dir containing the sdist).
pkgname=attackshark-x11
pkgver=0.1.0
pkgrel=1
pkgdesc="Open-source Linux configuration tool for the Attack Shark X11 mouse"
arch=(any)
url="https://github.com/attackshark-x11/attackshark-x11"
license=(MIT)
depends=(python python-gobject gtk4 libadwaita)
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgname-$pkgver.tar.gz")  # dist/attackshark_x11-$pkgver.tar.gz renamed
sha256sums=(SKIP)

build() {
  cd "attackshark_x11-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "attackshark_x11-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/udev/70-attackshark.rules "$pkgdir/usr/lib/udev/rules.d/70-attackshark.rules"
  install -Dm644 packaging/desktop/io.github.attackshark_x11.AttackSharkX11.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/icons/io.github.attackshark_x11.AttackSharkX11.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 packaging/metainfo/io.github.attackshark_x11.AttackSharkX11.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
}
